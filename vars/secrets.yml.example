# Manifest of required secrets to query dynamically from HashiCorp Vault
# Copy or rename this file to secrets.yml in your vars/ directory.
required_secrets:
  - key_name: git_user
    secret_path: ansible
  - key_name: git_pat
    secret_path: ansible
  - key_name: target_user
    secret_path: ansible
  - key_name: test_secret
    secret_path: ansible
